# PostgreSQL. Substitua o marcador pela senha local com percent-encoding de URL.
# Este marcador nao e uma credencial utilizavel.
DATABASE_URL="postgresql://meusaldo:SUBSTITUA_PELA_SENHA_URL_ENCODED@localhost:5432/meusaldo_dev?schema=public"

PORT=3001

# Origens exatas do frontend, separadas por virgula. Sem barra final.
CORS_ORIGINS=http://localhost:3000

# Em producao: NODE_ENV=production, HTTPS e CORS_ORIGINS explicito.
# Sessao opaca no banco; nao ha segredo JWT a configurar. Validade fixa: 1 hora.
# Seed opcional exige conta existente; nunca cria usuario/senha padrao.
# SEED_USUARIO_EMAIL=
