generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Receita {
  id        Int      @id @default(autoincrement())
  descricao String
  valor     Decimal  @db.Decimal(12, 2)
  categoria String
  data      DateTime
  criadoEm  DateTime @default(now())
  usuarioId Int
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([usuarioId, data, id])
}

model Despesa {
  id        Int      @id @default(autoincrement())
  descricao String
  valor     Decimal  @db.Decimal(12, 2)
  categoria String
  data      DateTime
  criadoEm  DateTime @default(now())
  usuarioId Int
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([usuarioId, data, id])
}

model Usuario {
  id              Int         @id @default(autoincrement())
  nome            String
  email           String      @unique
  senhaHash       String
  criadoEm        DateTime    @default(now())
  atualizadoEm    DateTime    @updatedAt
  receitas        Receita[]
  despesas        Despesa[]
  contas          Conta[]
  orcamentos      Orcamento[]
  sessoes         Sessao[]
  // Conta conjunta: o membro opera sobre os dados do titular (no máximo um membro por titular).
  titularId       Int?
  titular         Usuario?    @relation("Conjunta", fields: [titularId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  membros         Usuario[]   @relation("Conjunta")
  conviteHash     String?     @unique
  conviteExpiraEm DateTime?

  @@index([titularId])
}

model Sessao {
  tokenHash String   @id
  usuarioId Int
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  criadoEm  DateTime @default(now())
  expiraEm  DateTime

  @@index([usuarioId, expiraEm])
  @@index([expiraEm])
}

model Conta {
  id         Int       @id @default(autoincrement())
  descricao  String
  valor      Decimal   @db.Decimal(12, 2)
  categoria  String
  vencimento DateTime
  pagaEm     DateTime?
  criadoEm   DateTime  @default(now())
  usuarioId  Int
  usuario    Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([usuarioId, vencimento, id])
}

model Orcamento {
  id        Int     @id @default(autoincrement())
  mes       String
  categoria String
  limite    Decimal @db.Decimal(12, 2)
  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([usuarioId, mes, categoria])
}
